# Copy to .env.local in apps/web for local Next.js, or .env for Docker.
#
# Provider 配置(LLM / TTS)首选在应用内 /settings 页面填写,保存后立即生效;
# 下面的 LLM_* / TTS_* 环境变量是可选回退(数据库中的设置页配置优先),也供 CI 与评测脚本使用。
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=<your-llm-https-endpoint>
# LLM_API_KEY=<your-server-only-key>
# LLM_MODEL=<your-configured-model>
# LLM_PRICE_INPUT_PER_MTOK=<input-usd-per-million-tokens>
# LLM_PRICE_OUTPUT_PER_MTOK=<output-usd-per-million-tokens>
APP_PASSWORD=<your-private-access-password>
# Reverse proxies: set a public http(s) origin (no path/query/credentials).
# APP_ORIGIN=<your-public-http-or-https-origin>
DATABASE_PATH=<absolute-path-to-app.sqlite>
BLOB_DIR=<absolute-path-to-blobs-directory>
# TTS_PROVIDER=none
# Set all of these only when using openai-compatible TTS via env fallback.
# TTS_BASE_URL=<your-tts-https-endpoint>
# TTS_API_KEY=<your-server-only-tts-key>
# TTS_MODEL=<your-configured-tts-model>
# TTS_VOICE=<your-configured-voice>
# EVAL_BASELINE_PATH=<your-local-baseline-wordlist>
# EVAL_MAX_COST_USD=<positive-budget-at-most-one-usd>
