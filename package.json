{
  "name": "eng-learn",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @eng-learn/web dev",
    "build": "pnpm --filter @eng-learn/web build",
    "start": "pnpm --filter @eng-learn/web start",
    "test": "vitest run",
    "lint": "biome check . && tsx tools/check-boundaries.ts",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tools/tsconfig.json --noEmit",
    "e2e": "pnpm --filter @eng-learn/web e2e",
    "eval:generation": "tsx tools/eval/generation.ts",
    "report:experiment": "tsx tools/report/experiment.ts",
    "dev:demo": "tsx tools/demo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@eng-learn/core": "workspace:*",
    "@eng-learn/providers": "workspace:*",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.11.2"
}
